<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>

    <!--
      Exe, not WinExe, and that is the entire reason this project exists.

      Devlog.Host must be WinExe so the tray app shows no console window at
      logon. But a GUI-subsystem process does not hold the shell: PowerShell
      returns the prompt the instant it starts one, so output arrives after the
      prompt, `> out.txt` writes an empty file, and a pipe gets nothing.
      AttachConsole put the text on screen but could not fix any of that.

      A console-subsystem exe blocks, redirects and pipes like any normal tool.
      Two entry points, one composition root.
    -->
    <OutputType>Exe</OutputType>

    <!-- The command is `devlog`, not `Devlog.Cli`. -->
    <AssemblyName>devlog</AssemblyName>
    <RootNamespace>Devlog.Cli</RootNamespace>

    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devlog.Host\Devlog.Host.csproj" />
  </ItemGroup>

  <!--
    Both exes read the same configuration, and ContentRootPath is pinned to the
    executable's own folder — so each needs its own copy beside it. Linked
    rather than duplicated: one file on disk, edited in one place.
  -->
  <ItemGroup>
    <Content Include="..\Devlog.Host\appsettings.json"
             Link="appsettings.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Devlog.Host\appsettings.local.json"
             Link="appsettings.local.json"
             CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('..\Devlog.Host\appsettings.local.json')" />
  </ItemGroup>

</Project>
