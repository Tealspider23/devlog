<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows: required for Win32 P/Invoke and Microsoft.Win32.SystemEvents -->
    <TargetFramework>net10.0-windows</TargetFramework>

    <!--
      [LibraryImport] source-generates its marshalling stubs using unsafe code.
      This does not make our own code unsafe - none of it uses pointers - it just
      permits the generated interop layer to compile.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devlog.Core\Devlog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations travel inside the assembly so a single-file publish keeps them -->
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.11" />
  </ItemGroup>

</Project>
