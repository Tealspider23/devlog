bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
*.user
*.suo
*.userprefs
.vs/
*.binlog

# ---- Node / frontend ----
node_modules/
dist/
# Where `npm run build` puts the frontend so the collector can serve it.
